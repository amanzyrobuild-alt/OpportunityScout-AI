# ============================================================================
# OpportunityScout AI  -  Environment configuration template
# Copy this file to `.env` (in the backend/ folder) and fill in as needed.
# Everything is OPTIONAL for the prototype to run; sensible defaults are used.
# ============================================================================

# --- Application -----------------------------------------------------------
APP_NAME=OpportunityScout AI
# Public base URL used when building absolute links (e.g. in reminder text)
PUBLIC_BASE_URL=http://localhost:8000
# Comma-separated list of allowed CORS origins (the frontend dev/preview URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Database --------------------------------------------------------------
# SQLite file used for the prototype (relative to the backend process cwd)
DATABASE_URL=sqlite:///./opportunityscout.db

# --- Discovery / data sources ---------------------------------------------
# Include the clearly-labelled DEMO dataset (internships, scholarships,
# fellowships, competitions) so the dashboard covers more categories.
# Set to "false" to show ONLY real scraped data. Demo items are always
# flagged with a "DEMO" badge in the UI and never presented as real.
ENABLE_DEMO_DATA=true

# Run periodic background discovery + deadline checks automatically.
ENABLE_SCHEDULER=true
# How often (minutes) to re-check sources for new opportunities.
DISCOVERY_INTERVAL_MINUTES=360
# Max opportunities ingested per source per run (keeps the prototype light).
MAX_OPPORTUNITIES_PER_SOURCE=60

# --- Optional: permitted HTML / RSS sources --------------------------------
# You may configure additional public pages to scrape. The adapter parses
# each item using CSS selectors. Leave blank to skip.
# Format (one source per line):
#   NAME|URL|ITEM|TITLE_SEL|LINK_SEL|DATE_SEL|CATEGORY
# Example:
#   MySchool|https://example.edu/opportunities|.card|.card h3|a[href]|.card .date|Internship
# CONFIGURED_SOURCES=

# --- AI / LLM (OPTIONAL) ---------------------------------------------------
# The app works WITHOUT an LLM. When no key is set it uses transparent
# rule-based matching + template-based application drafting.
# When a key IS set, "auto" will use the LLM for eligibility narration and
# richer application drafts. Set LLM_PROVIDER=none to force rule-based mode.
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
